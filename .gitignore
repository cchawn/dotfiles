# macOS
.DS_Store

# editors
.vscode/*
.vsls.json
.idea/*
*.iml

# direnv
.envrc
.direnv

# deno
deno.lock

# mise
mise.local.toml

# claude
**/claude/*
!**/claude/commands
!**/claude/skills
**/claude/skills/synced
**/claude/skills/*/examples
!**/claude/CLAUDE.md
!**/claude/settings.base.json
!**/claude/settings.sh
!**/claude/statusline.sh
!**/claude/hooks
**/claude/hooks/herdr-*

# log files
*.*log

# ignore these directories
**/local
**/tmp
**/secrets
**/private/*

# keep these files
!/**/.keep
!/**/README.md
